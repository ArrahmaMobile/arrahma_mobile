# Internal scraper-to-API reload credential. The container generates one when
# omitted, but production may pin it for external scraper processes.
RELOAD_API_KEY=

# Relay authenticates to GET /_stats with this bearer token. Use the same strong
# value configured for Relay (minimum 24 characters; a 64-character hex token is
# recommended); never commit the real token.
PRODUCT_STATS_TOKEN=
